{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fire-crow-workspace",
  "pages_build_output_dir": "frontend/dist",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "VITE_APP_NAME": "Fire Crow Security Console",
    "VITE_API_URL": "https://api.firecrow.dev/api/v1",
    "NEXT_PUBLIC_API_URL": "https://api.firecrow.dev/api/v1",
    "FRONTEND_URL": "https://app.firecrow.dev",
    "BACKEND_BASE_URL": "https://api.firecrow.dev",
    "CORS_ORIGINS": "https://app.firecrow.dev",
    "AUTH_COOKIE_SECURE": "true",
    "AUTH_COOKIE_HTTPONLY": "true",
    "AUTH_COOKIE_SAMESITE": "lax"
  }
}
