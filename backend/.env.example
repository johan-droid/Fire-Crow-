# ============================================================
# Fire Crow - backend configuration TEMPLATE
# ============================================================
# Copy to .env.local and fill it in:
#
#     cp backend/.env.example backend/.env.local
#     cd backend && openssl rand -hex 32   # paste into SECRET_KEY
#     cd backend && openssl rand -hex 32   # paste into ENCRYPTION_KEY
#
# backend/.env.local is git-ignored and must never be committed.
# This template is tracked so a local environment is reproducible.
# ============================================================

# --- Required core. Startup FAILS CLOSED if any of these are missing. ---

# HMAC signing key for JWTs. >= 32 chars. Never a known dev placeholder.
SECRET_KEY=""

# Data-at-rest encryption key. >= 32 chars and MUST differ from SECRET_KEY
# (reusing one key for signing and encryption collapses the crypto boundary).
ENCRYPTION_KEY=""

# PostgreSQL connection string. Migrations run at startup, so the database
# must exist and be reachable or the process refuses to start.
DATABASE_URL="postgres://USER:PASSWORD@127.0.0.1:5432/firecrow"

# Public origin of the frontend. Used for CORS and for links in reports.
FRONTEND_URL="http://localhost:3000"

# Comma-separated extra allowed origins. The frontend origin above is always
# allowed; "*" is never honoured. Note: the Vite dev server binds port 3000
# (see frontend/vite.config.ts), not the Vite default 5173.
CORS_ORIGINS="http://localhost:3000"

# F1: Comma-separated CIDRs (or bare IPs) of reverse proxies whose
# X-Forwarded-For / X-Forwarded-Proto / CF-Connecting-IP headers may be
# trusted for client-IP attribution (rate limiting + audit logging). Empty
# (the default) trusts NO proxy: every request is keyed by its TCP peer, so a
# spoofed header never mints a fresh rate-limit bucket. Behind a platform
# proxy (Render, Cloudflare tunnel, nginx), list the proxy's own addresses
# here — private/loopback ranges are never trusted implicitly. Malformed
# values fail startup rather than silently collapsing all clients into one
# bucket. Cloudflare edge ranges are always trusted without listing them.
TRUSTED_PROXY_CIDRS=""

# --- Server ---

# Server host binding. Use 127.0.0.1 for local cargo run, but MUST be 0.0.0.0 in Docker/Render/cloud hosts.
HOST="127.0.0.1"
PORT="8000"
BACKEND_BASE_URL="http://localhost:8000"

# Verbose errors and localhost CORS defaults. Local convenience only.
# Security controls (rate limiting, error sanitization) are NOT disabled by
# DEBUG. Keep "false" in production.
DEBUG="false"

# --- Scanner execution (see docs/deployment/native-scanning.md) ---

# Execution backend: "container" (default) or "native".
#   container - run pinned scanner images through a Docker daemon (full
#               isolation). Requires DOCKER_HOST + a reachable daemon.
#   native    - run the pinned scanner binaries directly as hardened
#               subprocesses; NO Docker daemon needed. This is the Render
#               free-tier path. Opt-in only, and reports reduced
#               (process-level) isolation. Unset/anything else = container,
#               and an unrecognized value FAILS STARTUP.
# SCANNER_EXECUTION_MODE="container"

# Container mode only: Docker daemon / proxy endpoint, e.g. tcp://host:2375.
# Ignored in native mode.
# DOCKER_HOST=""

# Native-mode scanner binary paths (OPTIONAL). When unset, each scanner is
# looked up on PATH (the backend image installs gitleaks + osv-scanner there).
# A configured-but-missing path fails THAT scanner closed (reported
# "unavailable", coverage marked partial) — never silently substituted.
# Semgrep is not installed in native mode (its memory footprint exceeds the
# free tier), so it is reported unavailable there.
# GITLEAKS_BIN=""
# OSV_SCANNER_BIN=""
# SEMGREP_BIN=""

# --- Redis (OPTIONAL) ---
# Leave empty to run without Redis: the cache and Redis-backed revocation
# checks are skipped. Set a redis:// URL to enable them.
REDIS_URL=""
# NOTE: REDIS_PASSWORD is not read by this service. It is consumed by
# docker-compose.yml, which composes it into REDIS_URL and passes it to the
# redis container, so set it in the compose/shell environment, not for the app.
# REDIS_PASSWORD=""

# --- GitHub OAuth login + platform repo-read token (OPTIONAL) ---
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_TOKEN=""

# --- GitHub App (OPTIONAL) ---
# All-or-nothing: set BOTH the ID and the RSA private key PEM, or NEITHER.
# Setting only one, or a key that is not an RSA PEM, fails startup loudly.
# GITHUB_APP_ID=""
# GITHUB_APP_PRIVATE_KEY=""
# GITHUB_APP_WEBHOOK_SECRET=""

# --- Gemini narrative (OPTIONAL) ---
# Absent key/model = NotConfigured. The deterministic audit and report are
# unaffected when AI is unavailable or rejected.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_ATTEMPTS=2
# GEMINI_MAX_PROMPT_CHARS=60000

# --- Email delivery (OPTIONAL) ---
# Transport selection: a non-empty RESEND_API_KEY selects the Resend HTTP
# transport (https://api.resend.com); otherwise SMTP is used when SMTP_HOST
# and a sender address are set. With neither configured, delivery endpoints
# answer 501 rather than pretending a message was queued.
# Sender address: RESEND_FROM_EMAIL when set, else SENDER_EMAIL - for BOTH
# transports. A Resend key with no sender address anywhere fails startup
# (FC-OPS-EMAIL-001).
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=""
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SENDER_EMAIL=""

# --- Resend delivery webhooks (OPTIONAL) ---
# Required only if you want delivery/bounce/complaint events from Resend to
# update the delivery state machine. Set the signing secret shown in your
# Resend domain's webhook settings, and point Resend's webhook URL at
# /api/v1/webhooks/resend. Unset = webhooks disabled (501).
# RESEND_WEBHOOK_SECRET=""

# --- Telegram delivery (OPTIONAL) ---
# The chat ID is fixed here on purpose: no request may choose where a
# security report is sent.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# TELEGRAM_MESSAGE_LIMIT_CHARS=4096

# --- Cloudflare Turnstile (OPTIONAL) ---
# CF_TURNSTILE_ENABLED="false"
# CF_TURNSTILE_SITE_KEY=""
# CF_TURNSTILE_SECRET_KEY=""

# --- Payments (OPTIONAL) ---
# DODO_PAYMENTS_API_KEY=""
# DODO_PAYMENTS_WEBHOOK_SECRET=""
# DODO_PAYMENTS_ENVIRONMENT="sandbox"

# --- Object storage (OPTIONAL but REQUIRED for durable artifacts) ---
# Storage mode is EXPLICIT and fail-closed:
#   - Set ALL FOUR R2_* values  -> durable R2/S3 storage is used.
#   - Set NONE of them           -> local disk (EPHEMERAL: lost on restart,
#                                   redeploy, or instance replacement). Logged
#                                   loudly at startup. Fine for development.
#   - Set SOME but not all      -> STARTUP ERROR (a half-configured durable
#                                   backend is a misconfiguration, never a
#                                   silent fall-back to local disk).
# See documentation/PRODUCTION_DEPLOYMENT.md.
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT_URL=""
# R2_BUCKET_NAME=""
