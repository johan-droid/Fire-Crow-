# ============================================================
# Fire Crow - frontend configuration TEMPLATE
# ============================================================
# Copy to .env.local and fill it in:
#
#     cp frontend/.env.example frontend/.env.local
#
# frontend/.env.local is git-ignored and must never be committed.
# This template is tracked so a local environment is reproducible.
# ============================================================

# Base URL of the backend API, read by frontend/src/api/client.ts (getApiBase()).
#
# Leave it EMPTY for local development. With no value, the app uses the
# same-origin path /api/v1, which the Vite dev proxy forwards to
# http://localhost:8000 (see vite.config.ts server.proxy). That keeps auth
# cookies first-party and avoids cross-origin CORS entirely.
#
# Only set an ABSOLUTE http(s) origin (relative values are rejected loudly):
#   - to bypass the proxy: http://localhost:8000/api/v1 — then
#     http://localhost:3000 must be an allowed CORS origin in
#     backend/.env.local (FRONTEND_URL / CORS_ORIGINS).
#   - decoupled preview/production (Vercel -> Render): the Render backend
#     origin, e.g. https://<service>.onrender.com (the /api/v1 suffix is
#     appended automatically). REQUIRED on Vercel: without it every API call
#     hits the SPA fallback and returns index.html instead of JSON.
VITE_API_URL=

# Shown in the console UI.
VITE_APP_NAME="Fire Crow Security Console"