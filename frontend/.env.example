# ============================================================
# Fire Crow - frontend configuration TEMPLATE
# ============================================================
# Copy to .env.local and fill it in:
#
#     cp frontend/.env.example frontend/.env.local
#
# frontend/.env.local is git-ignored and must never be committed.
# This template is tracked so a local environment is reproducible.
# ============================================================

# Base URL of the backend API, read by frontend/src/App.tsx (getApiBase()).
#
# Leave it EMPTY for local development. With no value, the app resolves to
# http://localhost:8000/api/v1 when the page is served from localhost, and to
# the relative path /api/v1 everywhere else.
#
# Preferred local setup: set it to "/api/v1" so requests are same-origin and
# travel through the Vite dev proxy (server.proxy -> http://localhost:8000).
# That keeps auth cookies first-party and avoids cross-origin CORS entirely.
# Use the absolute http://localhost:8000/api/v1 only if you want to bypass the
# proxy; then http://localhost:3000 must be an allowed CORS origin in
# backend/.env.local (FRONTEND_URL / CORS_ORIGINS).
VITE_API_URL="/api/v1"

# Shown in the console UI.
VITE_APP_NAME="Fire Crow Security Console"