{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fire-crow-frontend",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "VITE_APP_NAME": "Fire Crow Security Console",
    "VITE_API_URL": "https://api.firecrow.dev/api/v1",
    "NEXT_PUBLIC_API_URL": "https://api.firecrow.dev/api/v1"
  }
}
