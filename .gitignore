# ==========================================
# Fire Crow - Git Ignore Policy
# ==========================================

# Secrets & Environment Files (NEVER commit secrets or API keys)
.env
.env.*
!.env.example
*.env
*.local
*.pem
*.key
*.crt
.dev.vars
backend/scripts/cf_secrets.json
deploy/cloudflare/cf_secrets.json

# Rust / Cargo Build Output
target/
**/target/
backend/target/
backend/workspace/
workspace/
*.rs.bk
*.rmeta

# Node.js & Vite Build Artifacts
node_modules/
**/node_modules/
dist/
dist-ssr/
frontend/dist/
build/
.output/
.wrangler/
wrangler-debug.log*

# Package Manager Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Storage & Temporary Audit Artifacts
tmp/
temp/
*.tmp
reports/*.pdf
downloads/

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.claude/
.agents/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
