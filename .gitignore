# ==========================================
# Fire Crow - Git Ignore Policy
# ==========================================

# Secrets & Environment Files (NEVER commit secrets or API keys)
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example
*.env
*.local
*.pem
*.key
*.crt
*.p12
*.pfx

# Explicit local overrides
frontend/.env.local
backend/.env.local

# Rust / Cargo Build Output
target/
**/target/
backend/target/
backend/workspace/
workspace/
*.rs.bk
*.rmeta
# sqlx offline data (if used)
.sqlx/
sqlx-data.json

# Node.js & Vite Build Artifacts
node_modules/
**/node_modules/
dist/
dist-ssr/
dist-tests/
frontend/dist/
frontend/dist-tests/
build/
.output/
.next/
out/
.vercel/
frontend/.vercel/
.vite/
frontend/.vite/
.turbo/
.parcel-cache/
cache/
*.tsbuildinfo
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo
# Vite / ESBuild
*.vite

# Package Manager Logs & Locks (keep package-lock.json, ignore logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# Uncomment to ignore lockfiles if you prefer (keep for reproducible installs):
# package-lock.json
# pnpm-lock.yaml
# yarn.lock

# Storage & Temporary Audit Artifacts
tmp/
temp/
*.tmp
reports/*.pdf
downloads/
uploads/
storage/

# Testing / Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
junit.xml
*.lcov

# Docker & Cloud Deployment
docker-compose.override.yml
docker-authz-plugin/target/
certs/
.render/

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.zed/
.fleet/
.claude/
.agents/
.opencode/
.cursor/
.playwright-mcp/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.code-workspace

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Database & Local State
*.sqlite
*.sqlite3
*.db
*.db-journal

# Misc
*.bak
*.orig
*.rej

# Local MCP / agent config (contains API keys)
opencode.json

# Local investigation screenshots (never commit)
aud-390*.png
fix-ov390*.png
fix[0-9]-ov390*.png
insp-390*.png
ov-390*.png
pop-ov390*.png

# ==========================================
# Internal audit & campaign artifacts (NEVER pushed to origin)
# ==========================================
# Verification evidence bundles (harnesses, logs, proofs) and campaign
# reports are local-only working documents. They describe exploitation
# details and are deliberately excluded from the public repository.
evidence/
/FC-*.md
