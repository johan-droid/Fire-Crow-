# ==========================================
# Fire Crow - Git Ignore Policy
# ==========================================

# Secrets & Environment Files (NEVER commit secrets or API keys)
.env
.env.*
!.env.example
*.env
*.local
*.pem
*.key
*.crt
.dev.vars
backend/scripts/cf_secrets.json
deploy/cloudflare/cf_secrets.json
# Explicit local overrides (Vite / Wrangler)
frontend/.env.local
backend/.env.local
.dev.vars.local
wrangler.toml.local

# Rust / Cargo Build Output
target/
**/target/
backend/target/
backend/workspace/
workspace/
*.rs.bk
*.rmeta
# sqlx offline data (if used)
.sqlx/
sqlx-data.json

# Node.js & Vite Build Artifacts
node_modules/
**/node_modules/
dist/
dist-ssr/
frontend/dist/
build/
.output/
.next/
out/
.wrangler/
.wrangler/tmp/
wrangler-debug.log*
.vite/
.turbo/
.parcel-cache/
cache/
*.tsbuildinfo
tsconfig.tsbuildinfo
# Vite / ESBuild
*.vite

# Package Manager Logs & Locks (keep package-lock.json, ignore logs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# Uncomment to ignore lockfiles if you prefer (keep for reproducible installs):
# package-lock.json
# pnpm-lock.yaml
# yarn.lock

# Storage & Temporary Audit Artifacts
tmp/
temp/
*.tmp
reports/*.pdf
downloads/
uploads/
storage/

# Testing / Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
junit.xml
*.lcov

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.claude/
.agents/
.opencode/
.cursor/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.code-workspace

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Database & Local State
*.sqlite
*.sqlite3
*.db
*.db-journal

# Misc
*.bak
*.orig
*.rej
